{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/app.ts",
    "src/index.ts",
    "src/config/**/*",
    "src/routes/auth.ts",
    "src/routes/appointment.ts",
    "src/utils/**/*"
  ]
}
